# MedSeek Backend — Environment Variables
# Copy this to .env and fill in the values

# Server
NODE_ENV=development
PORT=4000

# Database (Neon Postgres)
# Get this from: https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# CORS — frontend origin
CORS_ORIGIN=http://localhost:3000

# Auth (Phase 2)
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here

# AI — NVIDIA NIM RAG (Phase 3)
# Get key from: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=deepseek-ai/deepseek-v3.1
EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# Encryption — Vault (Phase 4)
# Generate with: openssl rand -hex 32
# WARNING: Changing this key makes existing encrypted records unreadable!
ENCRYPTION_KEY=your-64-char-hex-encryption-key
